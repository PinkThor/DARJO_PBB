// JPB 02/04/05/07/09 hanya memakai jalur non-standard bila luas > 1000 atau
// jumlah lantai > 4; kalau tidak, tetap PENILAIAN_STANDARD.
const JPB_BESAR = new Set(["02", "04", "05", "07", "09"]);

/**
 * Jalur mana yang dipakai PENILAIAN_BNG untuk satu bangunan.
 * @returns {"standard"|"non-standard"}
 */
function jalurPenilaian(kdJpb, luasBng, jmlLantaiBng) {
  const jpb = rapikan(kdJpb);
  if (jpb === "11") return "nol"; // JPB 11: nilai bangunan = 0
  if (JPB_BESAR.has(jpb)) {
    const luas = Number(luasBng) || 0;
    const lantai = Number(jmlLantaiBng) || 0;
    return luas > 1000 || lantai > 4 ? "non-standard" : "standard";
  }
  return JPB_NON_STANDAR[jpb] ? "non-standard" : "standard";
}

// ---------------------------------------------------------------------------
// KOMP_UTAMA_STD
// ---------------------------------------------------------------------------
function kompUtamaStd(b, tahun) {
  const jpb = rapikan(b.kdJpb);
  const jpbDbkb = jpb === "04" || jpb === "09" ? "02" : jpb;
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;

  // Cursor c_tipe_bng: BANGUNAN_LANTAI x TIPE_BANGUNAN. Tanpa ORDER BY, jadi
  // bila lebih dari satu tipe cocok, Oracle memilih yang mana pun. Di sini
  // kandidat diurutkan agar hasilnya deterministik (lihat catatan di laporan).
  const kandidat = [];
  for (const l of LANTAI) {
    if (l.jpb !== jpbDbkb) continue;
    if (!(l.lo <= lantai && l.hi >= lantai)) continue;
    for (const t of TIPE) {
      if (t.tipe !== l.tipe) continue;
      if (!(t.lo <= luas && t.hi >= luas)) continue;
      kandidat.push({ tipe: l.tipe, kdLantai: l.kd });
    }
  }

  // KAYU_ULIN: bila tabel tidak punya baris untuk tahun itu -> '0'.
  const ulin = ULIN.has(rapikan(tahun)) ? ULIN.get(rapikan(tahun)) : 0;

  for (const k of kandidat) {
    const nilai = STD.get(kunciStd(jpbDbkb, k.tipe, k.kdLantai, tahun));
    if (nilai === undefined) continue; // NO_DATA_FOUND -> nilai 0, lanjut
    const konstruksi = rapikan(b.jnsKonstruksiBng);
    // Perbaikan 19-01-2000: hanya konstruksi '4' DAN kayu ulin '0' yang 7/10.
    if (konstruksi === "4" && String(ulin) === "0") {
      return { nilai: (nilai * 7) / 10, tipe: k.tipe, kdLantai: k.kdLantai };
    }
    return { nilai, tipe: k.tipe, kdLantai: k.kdLantai };
  }
  return { nilai: 0, tipe: null, kdLantai: null };
}

// ---------------------------------------------------------------------------
// KOMP_MATERIAL
// ---------------------------------------------------------------------------
// kd_dinding 1..6 dipetakan ke digit kegiatan DBKB 1,2,3,7,8,(null).
const PETA_DINDING = { 1: "1", 2: "2", 3: "3", 4: "7", 5: "8", 6: null };

function material(kerja, digit, tahun) {
  if (digit === null || digit === undefined || digit === "") return 0;
  // substr(kd_kegiatan,2,1) = digit  -> kd_kegiatan berbentuk 'NN'
  for (const [k, v] of MAT) {
    const [kodeKerja, keg, thn] = k.split("|");
    if (kodeKerja !== kerja || thn !== rapikan(tahun)) continue;
    if (keg.slice(1, 2) === String(digit)) return v;
  }
  return 0;
}

// JPB8 memakai `kd_kegiatan = '0'||digit` (cocok penuh), bukan substr.
function materialPersis(kerja, kegiatan, tahun) {
  if (!kegiatan) return 0;
  return MAT.get(`${kerja}|${rapikan(kegiatan)}|${rapikan(tahun)}`) ?? 0;
}

function kompMaterial(b, tahun) {
  const lantai = Number(b.jmlLantaiBng) || 0;
  let atap = 0;
  let dinding = 0;
  let lantaiNilai = 0;
  let langit = 0;

  // Nilai atap dibagi jumlah lantai. Bila jumlah lantai 0 -> ZERO_DIVIDE,
  // yang di prosedur asli keluar sebagai `exception when others` pada blok
  // terluar -> SELURUH komp_material menjadi 0.
  if (lantai === 0) return 0;

  const digitAtap = rapikan(b.jnsAtapBng);
  if (digitAtap !== "") atap = material("23", digitAtap, tahun) / lantai;

  const dindingAsli = rapikan(b.kdDinding);
  if (dindingAsli !== "") dinding = material("21", PETA_DINDING[dindingAsli] ?? null, tahun);

  const digitLantai = rapikan(b.kdLantai);
  if (digitLantai !== "") lantaiNilai = material("22", digitLantai, tahun);

  const digitLangit = rapikan(b.kdLangitLangit);
  if (digitLangit !== "") langit = material("24", digitLangit, tahun);

  return atap + dinding + lantaiNilai + langit;
}

// ---------------------------------------------------------------------------
// Fasilitas
// ---------------------------------------------------------------------------
// `fasilitas` di UI berbentuk { "01": jumlah, "35": panjang, ... } dengan kode
// yang SUDAH kode DAT_FASILITAS_BANGUNAN (bukan kode item form).
function nilaiSatuanFasilitas(kd, ket, tahun, { jmlSatuan, jmlLantai, kdJpb, klsBintang }) {
  if (ket === "0") return NONDEP.get(`${kd}|${rapikan(tahun)}`) ?? 0;

  if (ket === "1") {
    // Untuk 30/31/32 (lift) kelas dep memakai JUMLAH LANTAI; lainnya jumlah satuan.
    const acuan = kd === "30" || kd === "31" || kd === "32" ? jmlLantai : jmlSatuan;
    for (const [k, v] of DEPMM) {
      const [kode, thn, lo, hi] = k.split("|");
      if (kode !== kd || thn !== rapikan(tahun)) continue;
      if (Number(lo) <= acuan && Number(hi) >= acuan) return v;
    }
    return 0;
  }

  if (ket === "2") {
    return DEPJPB.get(`${kd}|${rapikan(kdJpb)}|${rapikan(klsBintang)}|${rapikan(tahun)}`) ?? 0;
  }
  return 0;
}

// FASILITAS_SUSUT_X_LUAS: hanya status '0', lalu dikali luas bangunan.
// `opts.klsBintang` meneruskan kelas/tipe JPB (prosedur asli
// FASILITAS_SUSUT_X_LUAS menerima kd_jpb + kls_bintang; dipakai untuk
// fasilitas ketergantungan '2'). Default '0' = perilaku jalur standard.
function fasilitasXLuas(b, tahun, opts = {}) {
  let total = 0;
  const luas = Number(b.luasBng) || 0;
  const klsBintang =
    opts.klsBintang !== undefined ? rapikan(opts.klsBintang) : "0";
  for (const [kd, jml] of Object.entries(b.fasilitas || {})) {
    const satuan = Number(jml) || 0;
    if (satuan === 0) continue;
    const f = FAS.get(rapikan(kd));
    if (!f || f.status !== "0") continue;
    const nilai = nilaiSatuanFasilitas(rapikan(kd), f.ket, tahun, {
      jmlSatuan: satuan,
      jmlLantai: Number(b.jmlLantaiBng) || 0,
      kdJpb: rapikan(b.kdJpb),
      klsBintang,
    });
    total += nilai * satuan;
  }
  return total; // dikali luas oleh pemanggil
}

// FASILITAS_SUSUT: status '4'. Cursor memutar SEMUA fasilitas status '4',
// jadi yang tidak diisi operator bernilai 0 dan tidak menambah apa pun.
function fasilitasSusut(b, tahun) {
  let total = 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  for (const [kd, f] of FAS) {
    if (f.status !== "4") continue;
    const satuan = Number((b.fasilitas || {})[kd]) || 0;
    const nilai = nilaiSatuanFasilitas(kd, f.ket, tahun, {
      jmlSatuan: satuan,
      jmlLantai: lantai,
      kdJpb: rapikan(b.kdJpb),
      klsBintang: "0",
    });
    total += nilai * satuan;
  }
  return total;
}

// FASILITAS_TDK_SUSUT: status '5'. Khusus kode 44 (listrik) dibagi 1000.
function fasilitasTdkSusut(b, tahun) {
  let total = 0;
  for (const [kd, f] of FAS) {
    if (f.status !== "5") continue;
    const satuan = Number((b.fasilitas || {})[kd]) || 0;
    if (satuan === 0) continue;
    const nilai = nilaiSatuanFasilitas(kd, f.ket, tahun, {
      jmlSatuan: satuan,
      jmlLantai: Number(b.jmlLantaiBng) || 0,
      kdJpb: rapikan(b.kdJpb),
      klsBintang: "0",
    });
    total += kd === "44" ? (nilai * satuan) / 1000 : nilai * satuan;
  }
  return total;
}

// ---------------------------------------------------------------------------
// FUNCTION SUSUT
// ---------------------------------------------------------------------------
function umurEfektif(b, tahun, standard) {
  const thn = Number(tahun) || 0;
  const dibangun = Number(b.thnDibangunBng) || 0;
  const renovasi = Number(b.thnRenovasiBng) || 0;

  let umur;
  if (standard) {
    umur = renovasi > 0 ? thn - renovasi : thn - dibangun;
  } else {
    if (!(dibangun > 0)) return 0;
    if (renovasi > 0) {
      umur =
        thn - renovasi > 10
          ? Math.round(((thn - dibangun) + 2 * 10) / 3)
          : Math.round(((thn - dibangun) + 2 * (thn - renovasi)) / 3);
    } else {
      umur =
        thn - dibangun > 10
          ? Math.round(((thn - dibangun) + 2 * 10) / 3)
          : thn - dibangun;
    }
  }
  return umur > 40 ? 40 : umur;
}

function susut(b, tahun, nilai, standard) {
  const umur = umurEfektif(b, tahun, standard);
  const luas = Number(b.luasBng) || 0;
  const pembagi = luas === 0 ? 1 : luas;

  // NVL(vln_nilai,0) * 1000 / luas  -> rupiah per m²
  const biayaPenggantiBaru = (nilai * 1000) / pembagi;

  // RANGE_PENYUSUTAN: nilai_min < bpb <= nilai_max
  const r = RANGE.find((x) => x.lo < biayaPenggantiBaru && x.hi >= biayaPenggantiBaru);
  if (!r) return 0; // exception when others -> return 0

  const kondisi = rapikan(b.kondisiBng);
  const kunci = `${umur}|${r.kd}|${kondisi}`;
  return SUSUT.get(kunci) ?? 0; // NO_DATA_FOUND -> return 0
}

// ---------------------------------------------------------------------------
// PENILAIAN_STANDARD
// ---------------------------------------------------------------------------
/**
 * Nilai sistem satu bangunan (ribuan rupiah) untuk bangunan jalur standard.
 * @returns {{nilai:number, rincian:object}}
 */
function nilaiStandard(b, tahun) {
  const luas = Number(b.luasBng) || 0;

  // Normalisasi JPB seperti prosedur: 01/10/11 -> 01, 02/04/07/09 -> 02.
  const jpb = rapikan(b.kdJpb);
  const bNormal = { ...b };
  if (jpb === "01" || jpb === "10" || jpb === "11") bNormal.kdJpb = "01";
  else if (jpb === "02" || jpb === "04" || jpb === "07" || jpb === "09") bNormal.kdJpb = "02";

  const utama = kompUtamaStd(bNormal, tahun);
  const mat = kompMaterial(bNormal, tahun);
  const fasLuas = fasilitasXLuas(bNormal, tahun);

  const nilai1 = (utama.nilai + mat + fasLuas) * luas;

  const fasSusut = fasilitasSusut(bNormal, tahun);
  const sblSusut = nilai1 + fasSusut;

  const besarSusut = susut(bNormal, tahun, sblSusut, true);
  // round(besar/100, 2) lalu nilai - nilai*persen
  const persen = Math.round((besarSusut / 100) * 100) / 100;
  const stlSusut = sblSusut - sblSusut * persen;

  const fasTdkSusut = fasilitasTdkSusut(bNormal, tahun);
  const nilai = stlSusut + fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jpbDbkb: bNormal.kdJpb,
      tipe: utama.tipe,
      kdLantai: utama.kdLantai,
      kompUtama: utama.nilai,
      kompMaterial: mat,
      fasilitasXLuas: fasLuas,
      nilai1,
      fasilitasSusut: fasSusut,
      sebelumSusut: sblSusut,
      persenSusut: persen,
      setelahSusut: stlSusut,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB13 — apartemen.
 *
 * Berbeda dari jalur standard: komponen utama diambil dari DBKB_JPB13 memakai
 * KELAS jpb13 (bukan tipe luas), lalu fasilitas status '0'/'1'/'2'/'3' dikali
 * luas bangunan / jumlah unit / luas AC sentral, sesuai statusnya.
 *
 * `b.jpb` membawa data DAT_JPB13: kls13, jmlKamar, luasKmrAc, luasRngAc.
 */
function nilaiJpb13(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const jpbData = b.jpb || {};
  const kls = rapikan(jpbData.kls13);
  const jmlUnit = Number(jpbData.jmlKamar) || 0;
  const luasAcKamar = Number(jpbData.luasKmrAc) || 0;
  const luasAcRuang = Number(jpbData.luasRngAc) || 0;

  // DBKB_JPB13: kls + tahun + lantai_min <= lantai <= lantai_max
  let utama = 0;
  for (const r of JPB13) {
    if (r.kls !== kls || r.thn !== rapikan(tahun)) continue;
    if (!(r.lo <= lantai && r.hi >= lantai)) continue;
    utama = r.nilai;
    break;
  }

  let nilai = utama * luas;

  // Fasilitas: status menentukan pengalinya.
  let fas = 0;
  for (const [kd, f] of FAS) {
    if (!["0", "1", "2", "3"].includes(f.status)) continue;
    const satuan = Number((b.fasilitas || {})[kd]) || 0;
    const nilaiSatuan = nilaiSatuanFasilitas(kd, f.ket, tahun, {
      jmlSatuan: satuan,
      jmlLantai: lantai,
      kdJpb: "13",
      klsBintang: kls,
    });
    if (f.status === "0") fas += nilaiSatuan * satuan * luas;
    else if (f.status === "1") fas += nilaiSatuan * jmlUnit;
    else if (f.status === "2") fas += nilaiSatuan * luasAcKamar;
    else if (f.status === "3") fas += nilaiSatuan * luasAcRuang;
  }

  nilai += fas;

  // FASILITAS_SUSUT menimpa variabel yang sama lalu ditambahkan lagi.
  const fasSusut = fasilitasSusut(b, tahun);
  nilai += fasSusut;

  // SUSUT flag 0 = non-standard.
  const persen = susut(b, tahun, nilai, false);
  const potong = Math.round((persen * nilai) / 100);
  nilai -= potong;

  const fasTdkSusut = fasilitasTdkSusut(b, tahun);
  nilai += fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: "JPB13",
      kls,
      kompUtama: utama,
      nilaiKomponen: utama * luas,
      fasilitas: fas,
      fasilitasSusut: fasSusut,
      persenSusut: persen,
      potongan: potong,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB8 — bengkel / gudang / pertanian.
 *
 * Memakai DBKB_JPB8 (lebar bentang x tinggi kolom), DBKB_DAYA_DUKUNG,
 * DBKB_MEZANIN, dan menghitung dinding dari keliling x tinggi x 10/6.
 *
 * `b.jpb` membawa data DAT_JPB8: tingKolom, lbrBentang, luasMezzanine,
 * kelilingDinding, dayaDukungLantai.
 */
function nilaiJpb8(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const jpbData = b.jpb || {};
  const tingKolom = Number(jpbData.tingKolom) || 0;
  const lbrBentang = Number(jpbData.lbrBentang) || 0;
  const luasMezz = Number(jpbData.luasMezzanine) || 0;
  const keliling = Number(jpbData.kelilingDinding) || 0;
  // PENTING: type_konstruksi dibaca HANYA dari DAT_JPB8. Bila barisnya tidak
  // ada, prosedur asli menangkap exception dan menyetelnya NULL — bukan
  // memakai JNS_KONSTRUKSI_BNG. Akibatnya DBKB_DAYA_DUKUNG tidak ketemu
  // (daya = 0). Menggantinya dengan jns_konstruksi membuat nilai terlalu besar.
  const typeKonstruksi = jpbData.typeKonstruksi ? rapikan(jpbData.typeKonstruksi) : "";

  // Komponen utama per m² dari DBKB_JPB8.
  let kompUtama = 0;
  for (const r of JPB8) {
    if (r.thn !== rapikan(tahun)) continue;
    if (!(r.lbrLo <= lbrBentang && r.lbrHi >= lbrBentang)) continue;
    if (!(r.tingLo <= tingKolom && r.tingHi >= tingKolom)) continue;
    kompUtama = r.nilai;
    break;
  }

  // Material: JPB8 memakai kd_kegiatan = '0' || digit (bukan substr).
  const matAtap = materialPersis("23", "0" + rapikan(b.jnsAtapBng), tahun);
  const matLantai = materialPersis("22", "0" + rapikan(b.kdLantai), tahun);
  const matLangit = materialPersis("24", "0" + rapikan(b.kdLangitLangit), tahun);
  // Dinding: peta khusus JPB8 (1 -> 09, bukan 01).
  const petaDinding8 = { 1: "09", 2: "02", 3: "03", 4: "07", 5: "08", 6: null };
  const digitDinding = petaDinding8[rapikan(b.kdDinding)] ?? null;
  const matDinding = digitDinding ? materialPersis("21", digitDinding, tahun) : 0;

  const pembagiLantai = lantai === 0 ? 1 : lantai;
  const mat = matAtap / pembagiLantai + matLantai + matLangit;

  const daya = typeKonstruksi
    ? DAYA.get(`${typeKonstruksi}|${rapikan(tahun)}`) ?? 0
    : 0; // type_konstruksi NULL -> tidak ada baris DBKB_DAYA_DUKUNG

  // FASILITAS_SUSUT_X_LUAS dengan kd_jpb '08' dan kls_bintang NULL.
  const fasXLuas = fasilitasXLuas({ ...b, kdJpb: "08" }, tahun);

  const totalPerM2 = kompUtama + mat + daya + fasXLuas;
  const totalKaliLuas = totalPerM2 * luas;

  const nilaiDinding = keliling * tingKolom * (10 / 6) * matDinding;
  const mezanin = (MEZANIN.get(rapikan(tahun)) ?? 0) * luasMezz;

  const fasSusut = fasilitasSusut(b, tahun);
  const sebelumSusut = totalKaliLuas + nilaiDinding + mezanin + fasSusut;

  const persenMentah = susut(b, tahun, sebelumSusut, false);
  const persen = Math.round((persenMentah / 100) * 100) / 100;
  const setelahSusut = sebelumSusut - sebelumSusut * persen;

  const fasTdkSusut = fasilitasTdkSusut(b, tahun);

  return {
    nilai: Math.round(setelahSusut + fasTdkSusut),
    rincian: {
      jalur: "JPB8",
      kompUtama,
      kompMaterial: mat,
      dayaDukung: daya,
      fasilitasXLuas: fasXLuas,
      totalPerM2,
      totalKaliLuas,
      nilaiDinding,
      mezanin,
      fasilitasSusut: fasSusut,
      sebelumSusut,
      persenSusut: persen,
      setelahSusut,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * Pola A (mayoritas JPB): persen = round(besar/100, 2), lalu
 * setelah = sebelum - sebelum*persen.
 */
function susutPolaA(b, tahun, nilai, standard) {
  const besar = susut(b, tahun, nilai, standard);
  const persen = Math.round((besar / 100) * 100) / 100;
  const setelah = nilai - nilai * persen;
  return { besar, persen, setelah };
}

/**
 * Pola B (JPB7/JPB14): potongan = round(besar*nilai/100), lalu
 * setelah = nilai - potongan.
 */
function susutPolaB(b, tahun, nilai, standard) {
  const besar = susut(b, tahun, nilai, standard);
  const potong = Math.round((besar * nilai) / 100);
  const setelah = nilai - potong;
  return { besar, potong, setelah };
}

/**
 * PENILAIAN_JPB2/4/9/16 — bangunan kelas+lantai.
 * DBKB_JPBx dikunci kls + tahun + rentang lantai; fasilitas status '0'
 * memakai kelas asli (klsBintang) untuk ketergantungan '2'.
 *
 * `b.jpb` membawa data DAT_JPBx: kls2/kls4/kls9/kls16 (lihat BLOK_JPB;
 * JPB2 dan JPB9 berbagi key form `kls29`).
 */
function nilaiJpbKelas(b, tahun, jpb) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const jpbData = b.jpb || {};
  // Key form mengikuti BLOK_JPB: 02/09 berbagi `kls29`; 04->kls4, 16->kls16.
  const kls = rapikan(jpbData.kls29 || jpbData[`kls${Number(jpb)}`]);

  let kompUtama = 0;
  for (const r of JPB_KLS[jpb]) {
    if (r[0] !== kls || r[1] !== rapikan(tahun)) continue;
    if (!(Number(r[2]) <= lantai && Number(r[3]) >= lantai)) continue;
    kompUtama = Number(r[4]);
    break;
  }

  const fasLuas = fasilitasXLuas({ ...b, kdJpb: jpb }, tahun, { klsBintang: kls });
  const nilai1 = (kompUtama + fasLuas) * luas;
  const fasSusut = fasilitasSusut({ ...b, kdJpb: jpb }, tahun);
  const sebelumSusut = nilai1 + fasSusut;

  const s = susutPolaA({ ...b, kdJpb: jpb }, tahun, sebelumSusut, false);

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: jpb }, tahun);
  const nilai = s.setelah + fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: `JPB${jpb}`,
      kls,
      kompUtama,
      fasilitasXLuas: fasLuas,
      nilai1,
      fasilitasSusut: fasSusut,
      sebelumSusut,
      persenSusut: s.persen,
      setelahSusut: s.setelah,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB6/JPB12 — kelas/tipe + tahun, TANPA rentang lantai.
 * `b.jpb`: kls6 / kls12 (type parkir).
 */
function nilaiJpbSederhana(b, tahun, jpb) {
  const luas = Number(b.luasBng) || 0;
  // Key form: 12 -> `kls12` (type parkir), 06 -> `kls6`.
  const key = jpb === "12" ? "kls12" : `kls${Number(jpb)}`;
  const kls = rapikan((b.jpb || {})[key]);

  let kompUtama = 0;
  for (const r of JPB_SEDERHANA[jpb]) {
    if (r[0] !== kls || r[1] !== rapikan(tahun)) continue;
    kompUtama = Number(r[2]);
    break;
  }

  const fasLuas = fasilitasXLuas({ ...b, kdJpb: jpb }, tahun, { klsBintang: kls });
  const nilai1 = (kompUtama + fasLuas) * luas;
  const fasSusut = fasilitasSusut({ ...b, kdJpb: jpb }, tahun);
  const sebelumSusut = nilai1 + fasSusut;

  const s = susutPolaA({ ...b, kdJpb: jpb }, tahun, sebelumSusut, false);

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: jpb }, tahun);
  const nilai = s.setelah + fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: `JPB${jpb}`,
      kls,
      kompUtama,
      fasilitasXLuas: fasLuas,
      nilai1,
      fasilitasSusut: fasSusut,
      sebelumSusut,
      persenSusut: s.persen,
      setelahSusut: s.setelah,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB3 — pabrik. Mirip JPB8 (DBKB_JPB3 bentang x kolom) tetapi:
 *  - material memakai `'0'||digit` (materialPersis) dan HASILNYA dikali 1.3
 *    (atap+lantai+langit); dinding juga dikali 1.3;
 *  - daya dukung dari DBKB_DAYA_DUKUNG memakai type_konstruksi;
 *  - SUSUT TANPA round(persen) — persen = besar/100 langsung.
 * `b.jpb`: tingKolom, lbrBentang, luasMezzanine, kelilingDinding,
 * dayaDukungLantai (tipe konstruksi).
 */
function nilaiJpb3(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const jpbData = b.jpb || {};
  const tingKolom = Number(jpbData.tingKolom) || 0;
  const lbrBentang = Number(jpbData.lbrBentang) || 0;
  const luasMezz = Number(jpbData.luasMezzanine) || 0;
  const keliling = Number(jpbData.kelilingDinding) || 0;
  // PENTING: type_konstruksi (kolom DAT_JPB3/8) dipakai untuk DBKB_DAYA_DUKUNG,
  // BUKAN daya_dukung_lantai (nilai kg/m², kolom terpisah).
  const typeKonstruksi = jpbData.typeKonstruksi ? rapikan(jpbData.typeKonstruksi) : "";

  let kompUtama = 0;
  for (const r of JPB3) {
    if (r.thn !== rapikan(tahun)) continue;
    if (!(r.lbrLo <= lbrBentang && r.lbrHi >= lbrBentang)) continue;
    if (!(r.tingLo <= tingKolom && r.tingHi >= tingKolom)) continue;
    kompUtama = r.nilai;
    break;
  }

  const matAtap = materialPersis("23", "0" + rapikan(b.jnsAtapBng), tahun);
  const matLantai = materialPersis("22", "0" + rapikan(b.kdLantai), tahun);
  const matLangit = materialPersis("24", "0" + rapikan(b.kdLangitLangit), tahun);
  const pembagiLantai = lantai === 0 ? 1 : lantai;
  const mat = (matAtap / pembagiLantai + matLantai + matLangit) * 1.3;

  const daya = typeKonstruksi
    ? DAYA.get(`${typeKonstruksi}|${rapikan(tahun)}`) ?? 0
    : 0;

  const fasXLuas = fasilitasXLuas({ ...b, kdJpb: "03" }, tahun, { klsBintang: "" });
  // number(17,2): Oracle menyimpan 2 desimal di tiap penjumlahan; bulatkan
  // agar 771.59999... menjadi 771.6 (menghindari artefak float JS).
  const totalPerM2 = Math.round((kompUtama + mat + daya + fasXLuas) * 100) / 100;
  const totalKaliLuas = totalPerM2 * luas;

  const petaDinding3 = { 1: "09", 2: "02", 3: "03", 4: "07", 5: "08", 6: null };
  const digitDinding = petaDinding3[rapikan(b.kdDinding)] ?? null;
  const nilaiDinding =
    (digitDinding ? materialPersis("21", digitDinding, tahun) : 0) *
    keliling * tingKolom * (10 / 6) * 1.3;

  const mezanin = (MEZANIN.get(rapikan(tahun)) ?? 0) * luasMezz;

  const fasSusut = fasilitasSusut({ ...b, kdJpb: "03" }, tahun);
  const sebelumSusut = totalKaliLuas + nilaiDinding + mezanin + fasSusut;

  // JPB3: besar/100 TANPA round (beda dari JPB8 dan Pola A).
  const besarSusut = susut({ ...b, kdJpb: "03" }, tahun, sebelumSusut, false);
  const persen = besarSusut / 100;
  const setelahSusut = sebelumSusut - sebelumSusut * persen;

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: "03" }, tahun);

  return {
    nilai: Math.round(setelahSusut + fasTdkSusut),
    rincian: {
      jalur: "JPB3",
      kompUtama,
      kompMaterial: mat,
      dayaDukung: daya,
      fasilitasXLuas: fasXLuas,
      totalPerM2,
      totalKaliLuas,
      nilaiDinding,
      mezanin,
      fasilitasSusut: fasSusut,
      sebelumSusut,
      persenSusut: persen,
      setelahSusut,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * Fasilitas status '0'/'2'/'3' (JPB5) atau '0'/'1'/'2'/'3' (JPB7) dihitung
 * langsung dari peta fasilitas, meniru cursor cur_fasilitas di prosedur asli:
 *  - ket '0' -> FAS_NON_DEP; ket '1' -> FAS_DEP_MIN_MAX; ket '2' ->
 *    FAS_DEP_JPB_KLS_BINTANG (kd_jpb + kls_bintang); lainnya -> 0.
 * Pengali per status: '0' -> satuan*luas, '1' -> jumlah kamar (7),
 * '2' -> luas kamar AC, '3' -> luas ruang lain AC.
 */
function fasilitasStatusBanyak(b, tahun, jpb, klsBintang, { denganStatus1 }) {
  let total = 0;
  const luas = Number(b.luasBng) || 0;
  const jpbData = b.jpb || {};
  const jmlKamar = Number(jpbData.jmlKamar) || 0;
  const luasKmrAc = Number(jpbData.luasKmrAc) || 0;
  const luasRngAc = Number(jpbData.luasRngAc) || 0;

  for (const [kd, f] of FAS) {
    if (f.status === "1" && !denganStatus1) continue;
    if (!["0", "1", "2", "3"].includes(f.status)) continue;
    const satuan = Number((b.fasilitas || {})[kd]) || 0;

    const nilai = nilaiSatuanFasilitas(kd, f.ket, tahun, {
      jmlSatuan: satuan,
      jmlLantai: Number(b.jmlLantaiBng) || 0,
      kdJpb: jpb,
      klsBintang,
    });

    if (f.status === "0") total += nilai * satuan * luas;
    else if (f.status === "1") total += nilai * jmlKamar;
    else if (f.status === "2") total += nilai * luasKmrAc;
    else if (f.status === "3") total += nilai * luasRngAc;
  }
  return total;
}

/**
 * PENILAIAN_JPB5 — rumah sakit / klinik.
 * DBKB_JPB5 (kls + lantai); fasilitas status 0/2/3; ket '2' pakai
 * FAS_DEP_JPB_KLS_BINTANG dengan kd_jpb='05' dan kls_jpb5.
 * `b.jpb`: kls5, luasKmrAc, luasRngAc.
 */
function nilaiJpb5(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const kls = rapikan((b.jpb || {}).kls5);

  let kompUtama = 0;
  for (const r of JPB_KLS["05"]) {
    if (r[0] !== kls || r[1] !== rapikan(tahun)) continue;
    if (!(Number(r[2]) <= lantai && Number(r[3]) >= lantai)) continue;
    kompUtama = Number(r[4]);
    break;
  }
  const kompKaliLuas = kompUtama * luas;

  const fasStatus = fasilitasStatusBanyak(b, tahun, "05", kls, { denganStatus1: false });
  let nilai = kompKaliLuas + fasStatus;

  const fasSusut = fasilitasSusut({ ...b, kdJpb: "05" }, tahun);
  nilai += fasSusut;

  const s = susutPolaA({ ...b, kdJpb: "05" }, tahun, nilai, false);
  nilai = s.setelah;

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: "05" }, tahun);
  nilai += fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: "JPB5",
      kls,
      kompUtama,
      komponenXLuas: kompKaliLuas,
      fasilitasStatus: fasStatus,
      fasilitasSusut: fasSusut,
      persenSusut: s.persen,
      setelahSusut: s.setelah,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB7 — hotel / wisma.
 * DBKB_JPB7 (jns + bintang + lantai). Bintang '0' -> '5' (perbaikan
 * 21/10/2000). Fasilitas status 0/1/2/3; ket '2' pakai kd_jpb='07' +
 * bintang. Susut Pola B: potongan = round(besar*nilai/100).
 * `b.jpb`: kls7, bintang, jmlKamar, luasKmrAc, luasRngAc.
 */
function nilaiJpb7(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const lantai = Number(b.jmlLantaiBng) || 0;
  const jpbData = b.jpb || {};
  const jns = rapikan(jpbData.kls7);
  let bintang = rapikan(jpbData.bintang);
  if (bintang === "0") bintang = "5";

  let kompUtama = 0;
  for (const r of JPB7) {
    if (r.jns !== jns || r.bintang !== bintang || r.thn !== rapikan(tahun)) continue;
    if (!(r.lo <= lantai && r.hi >= lantai)) continue;
    kompUtama = r.nilai;
    break;
  }
  const kompKaliLuas = kompUtama * luas;

  const fasStatus = fasilitasStatusBanyak(b, tahun, "07", bintang, { denganStatus1: true });
  let nilai = kompKaliLuas + fasStatus;

  const fasSusut = fasilitasSusut({ ...b, kdJpb: "07" }, tahun);
  nilai += fasSusut;

  const s = susutPolaB({ ...b, kdJpb: "07" }, tahun, nilai, false);
  nilai = s.setelah;

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: "07" }, tahun);
  nilai += fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: "JPB7",
      jns,
      bintang,
      kompUtama,
      komponenXLuas: kompKaliLuas,
      fasilitasStatus: fasStatus,
      fasilitasSusut: fasSusut,
      potonganSusut: s.potong,
      setelahSusut: s.setelah,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB14 — kanopi. DBKB_JPB14 (tahun saja); TANPA
 * FASILITAS_SUSUT_X_LUAS. Susut Pola B: potongan = round(besar*nilai/100).
 * kondisi default '4' bila kosong (NVL(kondisi_bng,'4') di prosedur).
 */
function nilaiJpb14(b, tahun) {
  const luas = Number(b.luasBng) || 0;
  const kompUtama = JPB14.get(rapikan(tahun)) ?? 0;

  let nilai = kompUtama * luas;

  const fasSusut = fasilitasSusut({ ...b, kdJpb: "14" }, tahun);
  nilai += fasSusut;

  const bKondisi = b.kondisiBng ? b : { ...b, kondisiBng: "4" };
  const s = susutPolaB(bKondisi, tahun, nilai, false);
  nilai = s.setelah;

  const fasTdkSusut = fasilitasTdkSusut({ ...b, kdJpb: "14" }, tahun);
  nilai += fasTdkSusut;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: "JPB14",
      kompUtama,
      komponenXLuas: kompUtama * luas,
      fasilitasSusut: fasSusut,
      potonganSusut: s.potong,
      setelahSusut: s.setelah,
      fasilitasTdkSusut: fasTdkSusut,
    },
  };
}

/**
 * PENILAIAN_JPB15 — tangki minyak. Sangat berbeda:
 *  - nilai DBKB = f(jns_tangki, tahun, kapasitas min/max) — TANPA dikali luas;
 *  - susut dihitung INLINE (umur_efektif * 5, cap 50), bukan function SUSUT
 *    (tidak lewat RANGE_PENYUSUTAN/PENYUSUTAN);
 *  - tanpa fasilitas sama sekali.
 * `b.jpb`: kapasitasTangki, kls15 (letak tangki).
 */
function nilaiJpb15(b, tahun) {
  const jpbData = b.jpb || {};
  const letak = rapikan(jpbData.kls15);
  const kapasitas = Number(jpbData.kapasitasTangki) || 0;

  let nilaiDbkb = 0;
  for (const r of JPB15) {
    if (r.jns !== letak || r.thn !== rapikan(tahun)) continue;
    if (!(r.kapLo <= kapasitas && r.kapHi >= kapasitas)) continue;
    nilaiDbkb = r.nilai;
    break;
  }

  // umur efektif inline (sama dengan umurEfektif(false), lihat _jpb15.txt).
  const umur = umurEfektif(b, tahun, false);
  let besarSusut = umur * 5;
  if (besarSusut > 50) besarSusut = 50;

  const persen = Math.round((besarSusut / 100) * 100) / 100;
  const nilai = nilaiDbkb - nilaiDbkb * persen;

  return {
    nilai: Math.round(nilai),
    rincian: {
      jalur: "JPB15",
      letakTangki: letak,
      kapasitas: kapasitas,
      nilaiDbkb,
      umurEfektif: umur,
      besarSusut,
      persenSusut: persen,
      setelahSusut: nilai,
    },
  };
}


/**
 * Nilai sistem bangunan, memilih jalur seperti PENILAIAN_BNG.
 * Semua JPB non-standard (02..16) sudah ditiru; hanya JPB tanpa data lengkap
 * (mis. luas 0) yang mengembalikan `nilai: null`.
 *
 * @param {object} b        bangunan dari formulir
 * @param {string} tahun    tahun pajak ("2026")
 * @returns {{nilai:number|null, jalur:string, rincian:object|null, catatan:string}}
 */
function nilaiSistemBangunan(b, tahun) {
  const jpb = rapikan(b.kdJpb);

  // Tanpa JPB belum ada yang bisa dinilai: PENILAIAN_BNG memilih prosedur
  // berdasarkan kd_jpb, jadi JPB kosong bukan "bangunan standar" — jangan
  // dihitung dari material saja (itu akan menampilkan angka yang tidak sah).
  if (!jpb) {
    return { nilai: null, jalur: "belum", rincian: null, catatan: "pilih JPB dulu untuk menghitung nilai" };
  }

  const jalur = jalurPenilaian(b.kdJpb, b.luasBng, b.jmlLantaiBng);

  if (jalur === "nol") {
    return { nilai: 0, jalur, rincian: null, catatan: "JPB 11 — bangunan tidak kena pajak" };
  }

  if (jalur === "non-standard") {
    const hasilNonStandard = (h) => ({ nilai: h.nilai, jalur, rincian: h.rincian, catatan: "" });
    if (jpb === "13") return hasilNonStandard(nilaiJpb13(b, tahun));
    if (jpb === "08") return hasilNonStandard(nilaiJpb8(b, tahun));
    if (jpb === "03") return hasilNonStandard(nilaiJpb3(b, tahun));
    if (jpb === "05") return hasilNonStandard(nilaiJpb5(b, tahun));
    if (jpb === "07") return hasilNonStandard(nilaiJpb7(b, tahun));
    if (jpb === "14") return hasilNonStandard(nilaiJpb14(b, tahun));
    if (jpb === "15") return hasilNonStandard(nilaiJpb15(b, tahun));
    if (jpb === "02" || jpb === "04" || jpb === "09" || jpb === "16")
      return hasilNonStandard(nilaiJpbKelas(b, tahun, jpb));
    if (jpb === "06" || jpb === "12") return hasilNonStandard(nilaiJpbSederhana(b, tahun, jpb));
    return {
      nilai: null,
      jalur,
      rincian: null,
      catatan: `JPB ${jpb} memakai ${JPB_NON_STANDAR[jpb] || "penilaian khusus"} — belum ditiru`,
    };
  }

  // Bangunan tanpa luas belum bisa dinilai apa pun.
  if (!(Number(b.luasBng) > 0)) {
    return { nilai: null, jalur, rincian: null, catatan: "isi luas bangunan untuk menghitung nilai" };
  }

  const hasil = nilaiStandard(b, tahun);
  return { nilai: hasil.nilai, jalur, rincian: hasil.rincian, catatan: "" };
}


// Konversi nilai ke KELAS — salinan aturan PBB.PENENTUAN_KELAS, bukan tafsiran.
//
// Sumber: `all_source` prosedur `PBB.PENENTUAN_KELAS` (dibaca 2026-11-12):
//
//   vln_nilai_para := vln_nilai_perm2 / 1000;      -- tabel kelas pakai RIBUAN
//   SELECT kd_kls_tanah, nilai_per_m2_tanah, thn_awal_kls_tanah
//     FROM kelas_tanah
//    WHERE thn_awal_kls_tanah  <= tahun
//      AND thn_akhir_kls_tanah >= tahun
//      AND nilai_min_tanah <  vln_nilai_para
//      AND nilai_max_tanah >= vln_nilai_para
//      AND kd_kls_tanah NOT IN ('XXX','00');
//   EXCEPTION WHEN OTHERS THEN      -- termasuk NO_DATA_FOUND / TOO_MANY_ROWS
//      vln_njop_perm2 := vln_nilai_para;  kd := 'XXX';  thn_awal := '1986';
//   ...
//   vln_njop_perm2 := vln_njop_perm2 * 1000;
//
// Artinya: per m² rupiah dibagi 1000, dicari kelasnya, lalu NJOP per m²
// memakai nilai_per_m2 MILIK KELAS itu (bukan nilai mentahnya), dikali 1000.
// Kalau tidak ada kelas yang cocok (atau lebih dari satu — Oracle akan
// melempar TOO_MANY_ROWS), nilai mentah dipakai apa adanya dan kelas = 'XXX'.
//
// Rantai lengkap bumi (PBB.PENENTUAN_NJOP_BUMI):
//   nilai bidang = NIR x luas            (ribuan)  -> DAT_OP_BUMI.NILAI_SISTEM_BUMI
//   per m²       = total nilai / total luas x 1000
//   kelas        = PENENTUAN_KELAS(1, tahun, per m²)
//   NJOP bumi    = nilai_per_m2_kelas x total luas
const kelasRef = __KELAS__;
function nilaiZnt(){return 0;}

const JENIS_TANAH = 1;
const JENIS_BANGUNAN = 2;

const barisKelas = (jenis) => (jenis === JENIS_TANAH ? kelasRef.tanah : kelasRef.bng);

// Cadangan yang dipakai prosedur saat SELECT INTO gagal.
const CADANGAN = { kd: "XXX", thnAwal: "1986" };

/**
 * Kelas untuk satu nilai per m² (rupiah).
 *
 * @param {number} jenis  1 = tanah, 2 = bangunan
 * @param {string|number} tahun  tahun pajak ("2026")
 * @param {number} rupiahPerM2
 * @returns {{kd:string, perM2:number, thnAwal:string}} perM2 dalam rupiah
 */
function kelasDariNilai(jenis, tahun, rupiahPerM2) {
  const nilai = Number(rupiahPerM2) || 0;
  if (!(nilai > 0)) return { ...CADANGAN, perM2: 0 };

  const thn = String(tahun);
  const para = nilai / 1000; // tabel kelas memakai ribuan

  const cocok = barisKelas(jenis).filter(
    ([kd, awal, akhir, min, max]) =>
      String(awal) <= thn &&
      thn <= String(akhir) &&
      Number(min) < para &&
      Number(max) >= para &&
      kd !== "XXX" &&
      kd !== "00"
  );

  // Sama seperti pl/sql: 0 baris atau >1 baris -> pakai nilai mentah, kelas XXX.
  if (cocok.length !== 1) return { ...CADANGAN, perM2: Math.round(para * 1000) };

  const [kd, awal, , , , per] = cocok[0];
  return { kd, perM2: Math.round(Number(per) * 1000), thnAwal: String(awal) };
}

/**
 * Kelas tanah untuk satu bidang: NIR (rupiah/m²) -> kelas tanah.
 * @returns {{kd:string, perM2:number, thnAwal:string, nir:number}}
 */
function kelasTanahZnt(kec, kel, kdZnt, tahun) {
  const nir = nilaiZnt(kec, kel, kdZnt);
  return { ...kelasDariNilai(JENIS_TANAH, tahun, nir), nir };
}

/**
 * Kelas & nilai bangunan satu objek, mengikuti bentuk PENENTUAN_NJOP_BNG:
 * nilai sistem tiap bangunan dijumlahkan, dibagi total luas, lalu dipetakan
 * ke KELAS_BANGUNAN. `nilaiSistemBng` per bangunan diisi oleh proses penilaian
 * (DBKB) — bukan diketik operator.
 *
 * @param {Array} bangunan [{ luasBng, nilaiSistemBng }]  nilai dalam ribuan
 * @returns {{nilaiSistem:number, perM2Rata:number, kdKlsBng:string, njopBng:number}}
 */
function nilaiBangunanObjek(bangunan, tahun) {
  let nilaiSistem = 0;
  let luasTotal = 0;

  for (const b of bangunan || []) {
    const luas = Number(b.luasBng) || 0;
    const nilai = Number(b.nilaiSistemBng) || 0;
    luasTotal += luas;
    nilaiSistem += nilai;
  }

  const perM2Rata = luasTotal > 0 ? (nilaiSistem * 1000) / luasTotal : 0;
  const kelas = kelasDariNilai(JENIS_BANGUNAN, tahun, perM2Rata);

  return {
    nilaiSistem: Math.round(nilaiSistem),
    perM2Rata: Math.round(perM2Rata),
    kdKlsBng: perM2Rata > 0 ? kelas.kd : "XXX",
    njopBng: Math.round(perM2Rata > 0 ? kelas.perM2 * luasTotal : 0),
  };
}

/**
 * Nilai bumi satu objek, persis PENENTUAN_NJOP_BUMI.
 * @param {Array} bidang  [{ kdZnt, luasBumi }]
 * @returns {{nilaiSistem:number, perM2Rata:number, kdKlsTanah:string,
 *            njopPerM2:number, njopBumi:number, tanpaNir:number}}
 *
 * `nilaiSistem` dalam ribuan (seperti Oracle), `njopBumi` dalam rupiah.
 */
function nilaiBumiObjek(bidang, kec, kel, tahun) {
  let nilaiSistem = 0;
  let luasTotal = 0;
  let tanpaNir = 0;

  for (const b of bidang || []) {
    const luas = Number(b.luasBumi) || 0;
    const nir = nilaiZnt(kec, kel, b.kdZnt);
    luasTotal += luas;
    if (nir > 0) nilaiSistem += (luas * nir) / 1000;
    else if (luas > 0) tanpaNir += 1;
  }

  const perM2Rata = luasTotal > 0 ? (nilaiSistem / luasTotal) * 1000 : 0;
  const kelas = kelasDariNilai(JENIS_TANAH, tahun, perM2Rata);

  return {
    nilaiSistem: Math.round(nilaiSistem),
    perM2Rata: Math.round(perM2Rata),
    kdKlsTanah: kelas.kd,
    njopPerM2: kelas.perM2,
    njopBumi: Math.round(kelas.perM2 * luasTotal),
    tanpaNir,
  };
}


