    if(!table) return;
    let targetRow = null;
    table.querySelectorAll('tbody tr').forEach(tr=>{
      const cells = tr.querySelectorAll('td');
      if(cells.length<9) return;
      const noBangunan = cells[5] ? cells[5].textContent.trim() : '';
      const rowLuas = num(cells[6].textContent);
      const rowTahun = num(cells[7].textContent);
      let match = false;
      if(noBng && noBangunan===String(noBng).trim()) match = true;
      else if(rowLuas===luas && (rowTahun===tahun || !tahun)) match = true;
      else if(rowLuas===luas) match = true;
      if(match) targetRow = tr;
    });
    if(!targetRow) return;
    const td = targetRow.querySelector('.tm-njop-td');
    if(!td) return;
    td.textContent = (r.kelas.perM2>0? rp(r.kelas.perM2)+'/m²' : '—') + (r.catatan && r.nilai===0? ' ('+r.catatan+')':'');
    td.title = 'Nilai akurat dari form LSPOP. Total ≈ ' + (r.njop>0? rp(r.njop):'—') + ' | JPB '+r.b.kdJpb+' | Luas '+r.b.luasBng+' m²';
  } catch(e){}
}

function injectLiveCalculator(modal){
  const body = modal.querySelector('.modal-body') || modal;
  if(body.querySelector('.tm-njop-calc')) return;
  const hasLuas = !!body.querySelector('input[name="luas_bng"], input[name*="luas" i]');
  const hasJpb = !!body.querySelector('select[name="kd_jpb"], select[name*="jpb" i]');
  if(!hasLuas || !hasJpb) return;
  // clear any previous interval from an earlier open
  if(modal.__njopIv){ clearInterval(modal.__njopIv); modal.__njopIv=null; }
  const box = document.createElement('div');
  box.className = 'tm-njop-calc';
  box.style.cssText = 'margin:12px 0;padding:10px;border:1px solid #888;border-radius:8px;background:#f5f5f5;font-size:13px;';
  box.innerHTML = '<b>NJOP Bangunan (live)</b> <span class="tm-njop-out" style="margin-left:10px;font-weight:bold;color:#1a5;">—</span><div class="tm-njop-detail" style="margin-top:6px;font-size:12px;color:#444;"></div>';
  body.appendChild(box);
  const out = box.querySelector('.tm-njop-out');
  const detail = box.querySelector('.tm-njop-detail');
  const update = () => {
    const r = computeFromModal(body);
    out.textContent = r.catatan && r.nilai===0 ? (r.catatan) : (rp(r.njop) + ' total  (' + rp(r.kelas.perM2) + '/m², nilai sistem ' + Number(r.nilai).toLocaleString('id-ID') + ' ribu, kelas ' + r.kelas.kd + ')');
    detail.textContent = 'Jalur: ' + r.jalur + ' | JPB ' + r.b.kdJpb + ' | Luas ' + r.b.luasBng + ' m² | Lantai ' + r.b.jmlLantaiBng + ' | per m² mentah ' + r.perM2;
    try {
      const noBng = (modal.querySelector('[name="no_bng"]')||{}).value || '';
      const key = String(noBng).trim() || (r.b.luasBng+'|'+r.b.thnDibangunBng);
      if(noBng) window.__njopCache.byNo[String(noBng).trim()] = r.kelas.perM2;
      window.__njopCache.byLT[r.b.luasBng+'|'+r.b.thnDibangunBng] = r.kelas.perM2;
    } catch(e){}
    syncRowFromModal(modal, r);
  };
  body.addEventListener('input', update, true);
  body.addEventListener('change', update, true);
  update();
  const iv = setInterval(update, 1500);
  modal.__njopIv = iv;
  const onHide = () => { clearInterval(iv); modal.__njopIv=null; };
  modal.addEventListener('hidden.bs.modal', onHide, {once:true});
  if(window.jQuery){ try { window.jQuery(modal).one('hidden.bs.modal', onHide); } catch(e){} }
}

function bindModalShow(m){
  if(m.__njopBound) return;
  m.__njopBound = true;
  const handler = () => {
    let tries=0;
    const attempt = () => {
      tries++;
      try { injectLiveCalculator(m); } catch(e){}
      if(!m.querySelector('.tm-njop-calc') && tries < 20) setTimeout(attempt, 200);
    };
    setTimeout(attempt, 100);
  };
  m.addEventListener('shown.bs.modal', handler);
  if(window.jQuery){ try { window.jQuery(m).on('shown.bs.modal', handler); } catch(e){} }
}

function scanModals(){
  document.querySelectorAll('.modal.show, .modal.in, .modal[style*="display: block"], .modal').forEach(m=>{
    bindModalShow(m);
    injectLiveCalculator(m);
  });
}


function parseFieldsFromHtml(html){
  const doc = new DOMParser().parseFromString(html,'text/html');
  const get=(name)=>{ const e=doc.querySelector('[name="'+name+'"]'); return e ? (e.value||'').trim() : ''; };
  const selVal=(name)=>{
    const e=doc.querySelector('select[name="'+name+'"]');
    if(!e) return '';
    const opt=e.querySelector('option[selected]'); return opt ? (opt.value||'').trim() : (e.value||'').trim();
  };
  return {
    kdJpb: selVal('kd_jpb') || get('kd_jpb'),
    luasBng: num(get('luas_bng')),
    jmlLantaiBng: num(get('jml_lantai_bng'))||1,
    thnDibangunBng: num(get('thn_dibangun_bng'))||2020,
    thnRenovasiBng: num(get('thn_renovasi_bng'))||0,
    kondisiBng: selVal('kondisi_bng') || get('kondisi_bng') || '2',
    jnsKonstruksiBng: selVal('jns_konstruksi_bng') || get('jns_konstruksi_bng') || '02',
    jnsAtapBng: selVal('jns_atap_bng') || get('jns_atap_bng') || '3',
    kdDinding: selVal('kd_dinding') || get('kd_dinding') || '3',
    kdLantai: selVal('kd_lantai') || get('kd_lantai') || '2',
    kdLangitLangit: selVal('kd_langit_langit') || get('kd_langit_langit') || '2',
    noBng: get('no_bng')
  };
}

function computeFromFields(f){
  const b = {
    kdJpb: (f.kdJpb||'01').padStart(2,'0'),
    luasBng: f.luasBng,
    jmlLantaiBng: f.jmlLantaiBng,
    thnDibangunBng: f.thnDibangunBng,
    thnRenovasiBng: f.thnRenovasiBng,
    kondisiBng: f.kondisiBng,
    jnsKonstruksiBng: f.jnsKonstruksiBng,
    jnsAtapBng: f.jnsAtapBng,
    kdDinding: f.kdDinding,
    kdLantai: f.kdLantai,
    kdLangitLangit: f.kdLangitLangit,
    fasilitas: {}
  };
  const thn = new Date().getFullYear();
  const jalur = (typeof jalurPenilaian==='function') ? jalurPenilaian(b.kdJpb, b.luasBng, b.jmlLantaiBng) : 'standard';
  let hitung=null;
  try {
    if(jalur==='nol') hitung={nilai:0};
    else if(jalur==='standard') hitung=nilaiStandard(b,thn);
    else {
      const map = { '02':()=>nilaiJpbKelas(b,thn,'02'), '04':()=>nilaiJpbKelas(b,thn,'04'), '05':()=>nilaiJpb5(b,thn), '06':()=>nilaiJpbSederhana(b,thn,'06'), '07':()=>nilaiJpb7(b,thn), '08':()=>nilaiJpb8(b,thn), '09':()=>nilaiJpbKelas(b,thn,'09'), '12':()=>nilaiJpbSederhana(b,thn,'12'), '13':()=>nilaiJpb13(b,thn), '14':()=>nilaiJpb14(b,thn), '15':()=>nilaiJpb15(b,thn), '16':()=>nilaiJpbKelas(b,thn,'16') };
      if(b.kdJpb==='03') hitung=nilaiJpb3(b,thn);
      else if(map[b.kdJpb]) hitung=map[b.kdJpb]();
    }
  } catch(e){}
  const nilai = (hitung && hitung.nilai!=null) ? hitung.nilai : 0;
  const perM2 = b.luasBng>0 ? Math.round((nilai*1000)/b.luasBng) : 0;
  let kelas = { kd:'XXX', perM2:0 };
  try { kelas = kelasDariNilai(JENIS_BANGUNAN, thn, perM2); } catch(e){}
  const njop = perM2>0 ? Math.round(kelas.perM2 * b.luasBng) : 0;
  return { b, nilai, perM2, kelas, njop, jalur, hitung };
}

const _fetchQueue = [];
let _fetchRunning = 0;
const _FETCH_CONC = 3;
function enqueueFetch(fn){ _fetchQueue.push(fn); pumpFetch(); }
function pumpFetch(){
  while(_fetchRunning < _FETCH_CONC && _fetchQueue.length){
    const fn = _fetchQueue.shift();
    _fetchRunning++;
    Promise.resolve().then(fn).finally(()=>{ _fetchRunning--; pumpFetch(); });
  }
}

function autoPullRow(tr, url, td){
  const noBangunan = (tr.querySelectorAll('td')[5]||{}).textContent?.trim() || '';
  const key = url;
  if(window.__njopCache.byUrl && window.__njopCache.byUrl[key]!=null){ applyRow(td, window.__njopCache.byUrl[key], 'cache'); return; }
  td.textContent = '…';
  enqueueFetch(async ()=>{
    try {
      const res = await fetch(url, {credentials:'same-origin'});
      const html = await res.text();
      const f = parseFieldsFromHtml(html);
      const r = computeFromFields(f);
      if(!window.__njopCache.byUrl) window.__njopCache.byUrl = {};
      window.__njopCache.byUrl[key] = r.kelas.perM2;
      if(f.noBng) window.__njopCache.byNo[String(f.noBng).trim()] = r.kelas.perM2;
      td.textContent = (r.kelas.perM2>0? rp(r.kelas.perM2)+'/m²' : '—');
      td.title = 'Akurat dari auto-fetch LSPOP. Total ≈ ' + (r.njop>0? rp(r.njop):'—') + ' | JPB '+r.b.kdJpb+' | Luas '+r.b.luasBng+' m² | '+r.jalur;
      // also update modal cache if opened later
      if(noBangunan) window.__njopCache.byNo[noBangunan] = r.kelas.perM2;
    } catch(e){ td.textContent = 'err'; td.title = String(e); }
  });
}

function applyRow(td, val, src){ td.textContent = (val>0? rp(val)+'/m²':'—'); td.title = 'Sumber: '+src; }

function injectRowColumn(){
  const table = document.getElementById('lspopTable');
  if(!table) return;
  const thead = table.querySelector('thead tr');
  if(thead && !thead.querySelector('.tm-njop-th')){
    const th = document.createElement('th');
    th.className='tm-njop-th';
    th.textContent = 'NJOP-BNG /m²';
    thead.appendChild(th);
  }
  table.querySelectorAll('tbody tr').forEach(tr=>{
    if(tr.querySelector('.tm-njop-td')) return;
    const cells = tr.querySelectorAll('td');
    const td = document.createElement('td');
    td.className='tm-njop-td';
    td.textContent = '…';
    tr.appendChild(td);
    // find LSPOP url in row links
    const link = tr.querySelector('a.showModal[href*="temp-bangunan"], a[href*="temp-bangunan"]');
    const url = link ? link.getAttribute('href') : null;
    if(url){
      autoPullRow(tr, url, td);
    } else {
      // fallback heuristic
      let luas=0, tahun=0;
      if(cells.length>=8){ luas=num(cells[6].textContent); tahun=num(cells[7].textContent); }
      td.textContent = 'n/a';
    }
  });
}

function scan(){
  scanModals();
  injectRowColumn();
}

const obs = new MutationObserver(()=>scan());
obs.observe(document.body, {childList:true, subtree:true});
document.addEventListener('click', ()=>{ setTimeout(scan, 400); }, true);
scan();
setInterval(scan, 2000);

